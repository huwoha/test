{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: 开发版编译 (Debug)",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "开发版编译（快速、带调试信息、体积小、需要 MinGW DLL）。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: 发布版编译 (Release)",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-O2",
                "-static",
                "-finput-charset=UTF-8",
                "-fexec-charset=GBK",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "发布版编译（静态链接、GBK中文、开箱即用、无需额外 DLL、无调试信息）。"
        },
        {
            "label": "📦 一键打包 (编译+压缩)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "C/C++: 发布版编译 (Release)"
            ],
            "command": "powershell",
            "args": [
                "-Command",
                "Compress-Archive -Path '${fileDirname}\\${fileBasenameNoExtension}.exe' -DestinationPath '${fileDirname}\\${fileBasenameNoExtension}_v1.0.zip' -Force; Write-Host '✅ 打包完成: ${fileDirname}\\${fileBasenameNoExtension}_v1.0.zip'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "先用发布版编译，再自动打包成 zip 文件。"
        }
    ],
    "version": "2.0.0"
}
